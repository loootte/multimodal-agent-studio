      "id": "text.reply",
      "category": "text",
      "kind": "chat",
      "prompt": "只聊天，随便说一句",
      "fake_mode": "ok",
      "expect": {
        "status": "completed",
        "text_equals": "你好",
        "comfy_prompts": 0
      },
      "live_expect": {
        "status": "completed",
        "text_nonempty": true,
        "comfy_prompts": 0
      }
    },
