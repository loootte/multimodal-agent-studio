{
  "schema": "mas.tool/1",
  "name": "accept_local_content",
  "version": "1.0.0",
  "description": "在用户本机界面弹出输入框（或文件选择），用户在框里填写；正文不经过模型，你只收到句柄。要出图但还没有提示词句柄时调用它（purpose=image_prompt），绝不要让用户把提示词贴到聊天里。多张出图时在 plan_images 之后调用。不要填写正文、字节、路径或文件名。",
  "order": 10,
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "purpose"
    ],
    "properties": {
      "purpose": {
        "type": "string",
        "enum": [
          "image_prompt",
          "keep"
        ],
        "description": "用途。出图用 image_prompt，留在本机用 keep。其他文字会被丢掉。"
      },
      "kind": {
        "type": "string",
        "enum": [
          "text",
          "file"
        ],
        "description": "text 收集文字，file 收集文件。不填则是 text。"
      }
    }
  },
  "mutating": true,
  "confirm": "always",
  "entry": {
    "kind": "host"
  },
  "config": [],
  "requires": {
    "backends": [],
    "python": []
  },
  "permissions": {
    "read_local_content": true,
    "network": false,
    "write_files": true,
    "send_local_to_model": false
  }
}
