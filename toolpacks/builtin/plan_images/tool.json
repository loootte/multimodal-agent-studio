{
  "schema": "mas.tool/1",
  "name": "plan_images",
  "version": "1.0.0",
  "description": "用户的请求意味着要多张图片时（明说张数、一组、一套、系列、每季一张等），第一步就调用一次，在收集提示词和 generate_image 之前，count 按用户请求填。只要一张时可以不调。不要先追问变体：用户没说时默认同一提示词、不同 seed。之后每张单独调用一次 generate_image。",
  "order": 55,
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "count"
    ],
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "这一轮要生成的总张数，1 到 20。"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "可选。每张的简短区别（如春、夏、秋、冬），不要写本地提示词正文。"
      }
    }
  },
  "mutating": false,
  "confirm": "never",
  "entry": {
    "kind": "host"
  },
  "config": [],
  "requires": {
    "backends": [],
    "python": []
  },
  "permissions": {
    "read_local_content": false,
    "network": false,
    "write_files": false,
    "send_local_to_model": false
  }
}
