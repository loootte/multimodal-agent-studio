{
  "schema": "mas.tool/1",
  "name": "retrieve_local",
  "version": "1.0.0",
  "description": "检索本会话的附件、本地内容和生成结果。只传入查询词。结果只有来源标识、种类、媒体类型、大小和可打开的地址。不要填写正文、字节、路径或文件名。",
  "order": 25,
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "description": "检索词。匹配句柄、种类、用途、名称或媒体类型。"
      }
    }
  },
  "mutating": false,
  "confirm": "never",
  "entry": {
    "kind": "host"
  },
  "config": [],
  "requires": {
    "backends": [],
    "python": []
  },
  "permissions": {
    "read_local_content": true,
    "network": false,
    "write_files": false,
    "send_local_to_model": false
  }
}
